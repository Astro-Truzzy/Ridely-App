# Supabase (required)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (native tiles + Places/Directions via edge proxy)
# Restrict Android/iOS keys by package/bundle + SHA-1. Rotate if ever committed.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
# Optional alias used by some clients
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Native Android gradle also reads GOOGLE_MAPS_ANDROID_API_KEY (EAS env / local, not committed)

# OAuth (optional)
EXPO_PUBLIC_OAUTH_GOOGLE_ENABLED=false

# LiveKit voice (optional until calls are enabled)
EXPO_PUBLIC_LIVEKIT_URL=

# Email confirmation deep link / web fallback
EXPO_PUBLIC_WEB_URL=

# Sentry (error monitoring — DSN is public/safe in the client)
EXPO_PUBLIC_SENTRY_DSN=

# Paystack client (optional — used to show a "Test payments" banner)
# Public key is not a secret. Set TEST_MODE=false when you switch to live keys.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
EXPO_PUBLIC_PAYSTACK_TEST_MODE=true

# CLI / EAS only — never ship these in the app binary
# SUPABASE_ACCESS_TOKEN=
# PAYSTACK_SECRET_KEY=   # also set as Supabase Edge Function secret
# SENTRY_ORG=williams-group
# SENTRY_PROJECT=android
# SENTRY_AUTH_TOKEN=     # org auth token for source maps / dSYMs (eas secret or local .env)
