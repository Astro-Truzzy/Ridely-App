.expo/
dist/
web-build/
expo-env.d.ts

# native
# android/ and ios/ are generated by `expo prebuild` (CNG) and must not be committed.
# Regenerate with: npm run android:clean  /  npx expo prebuild --clean
android/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
