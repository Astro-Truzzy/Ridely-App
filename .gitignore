.cursor/
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase service account key (FCM) - do not commit; use with eas credentials
*firebase*service*account*.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo
