# dependencies
node_modules/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
# android/ and ios/ are generated by `expo prebuild` (CNG) and must not be committed.
# Regenerate with: npm run android:clean  /  npx expo prebuild --clean
android/
ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# metro
.metro-health-check*

# debug
.cursor/
npm-debug.*
yarn-debug.*
yarn-error.*

# macos
.DS_Store
*.pem

# local env files
.env*.local
.env

# Firebase service account key (FCM) - do not commit; use with eas credentials
*firebase*service*account*.json
*-firebase-adminsdk-*.json

# typescript
*.tsbuildinfo

# Play Console service account / FCM config
secrets/
google-services.json
store/play/.render-tmp/

# python bytecode
__pycache__/
*.pyc

# supabase CLI local state (versions, project refs)
supabase/.temp/

# generated video-ad frames
store/video-ad/frames/

# generated launch-video output (brag skill artifacts)
brag-output/
